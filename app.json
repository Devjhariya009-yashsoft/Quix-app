{
  "expo": {
    "name": "Test India",
    "slug": "test-india",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/logo/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "testindia",
    "splash": {
      "image": "./assets/logo/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahakaushal.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show your city.",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location to show your city.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mahakaushal.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "mahakaushal.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "notification": {
        "icon": "./assets/logo/icon.png"
      }
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3607bfc9-6417-4c79-b80e-94810fd6b925"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@react-native-firebase/app",
        {
          "android": {
            "googleServicesFile": "./google-services.json"
          }
        }
      ],
      "@react-native-firebase/messaging",
      "expo-asset"
    ],
    "web": {
      "favicon": "./assets/logo/icon.png"
    },
    "owner": "yashsoftsolution"
  }
}
