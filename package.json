{
  "name": "test-india",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "set EXPO_USE_FAST_RESOLVER=1&& expo start --clear",
    "dev:client": "set EXPO_USE_FAST_RESOLVER=1&& expo start --dev-client --clear",
