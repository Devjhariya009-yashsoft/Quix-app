      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay",
          "react-native-snap-carousel",
          "react-native-vector-icons",
          "socket.io-client",
          "react-native-dropdown-picker",
          "react-native-swiper",
